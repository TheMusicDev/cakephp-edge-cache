{
    "name": "themusicdev/edge-cache",
    "description": "CakePHP 5 plugin: cache headers for CDN-fronted sites (public pages cached at the edge, forms and everything else never), cookie guard, ETag, Cloudflare purge",
    "type": "cakephp-plugin",
    "keywords": ["cakephp", "plugin", "cache", "cdn", "cloudflare", "etag", "cache-control", "csrf"],
    "homepage": "https://github.com/TheMusicDev/cakephp-edge-cache",
    "license": "MIT",
    "authors": [
        {
            "name": "TheMusicDev",
            "homepage": "https://themusicdev.llc"
        }
    ],
    "support": {
        "issues": "https://github.com/TheMusicDev/cakephp-edge-cache/issues",
        "source": "https://github.com/TheMusicDev/cakephp-edge-cache"
    },
    "require": {
        "php": ">=8.2",
        "cakephp/cakephp": "^5.2"
    },
    "require-dev": {
        "captainhook/captainhook": "^5.29",
        "captainhook/plugin-composer": "^5.3",
        "cakephp/cakephp-codesniffer": "^5.3",
        "phpstan/phpstan": "^2",
        "phpunit/phpunit": "^11.5.3 || ^12.1.3 || ^13.0",
        "ramsey/conventional-commits": "^1.7"
    },
    "autoload": {
        "psr-4": {
            "TheMusicDev\\EdgeCache\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "TheMusicDev\\EdgeCache\\Test\\": "tests/",
            "TestApp\\": "tests/test_app/src/"
        }
    },
    "scripts": {
        "check": [
            "@test",
            "@cs-check",
            "@stan"
        ],
        "cs-check": "phpcs --colors -p",
        "cs-fix": "phpcbf --colors -p",
        "stan": "phpstan analyse --no-progress --memory-limit=512M",
        "test": "phpunit --colors=always"
    },
    "config": {
        "allow-plugins": {
            "captainhook/plugin-composer": true,
            "dealerdirect/phpcodesniffer-composer-installer": true,
            "cakephp/plugin-installer": true
        },
        "sort-packages": true
    }
}
